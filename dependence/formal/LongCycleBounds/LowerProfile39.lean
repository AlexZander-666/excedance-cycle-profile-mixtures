theorem simple : SimpleEndpointRow 39 (row 39 Counterexample.weight) := by
  have e := coefficients_correct weightInt 39
  rw [table] at e
  have h : row 39 Counterexample.weight = X * ofCoeffs coeffs := by
    change row 39 (fun j => (Counterexample.weightInt j : ℝ)) = X * ofCoeffs coeffs
    simpa only [ofCoeffs,Int.cast_zero,C_0,zero_add] using e.symm
  obtain ⟨cert⟩ := negativeMeshOK_sound signs
