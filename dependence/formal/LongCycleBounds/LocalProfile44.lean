open Counterexample (coefficients coefficients_correct)
open Mixed44 (allowedA allowedB weights)

/-- Numerator of the independent probability at cycle length j after scaling by 2^j. -/
def lifted : ℕ → ℤ
  | 0 => 0
  | j+1 => 2^j * (Mixed44.profile allowedA (j+1) + 1 * Mixed44.profile allowedB (j+1))

noncomputable def marginal (j : ℕ) : ℝ :=
  (1/2) * weights allowedA j + (1/2) * weights allowedB j

theorem lift_eq (j : ℕ) : (lifted j : ℝ) = (2:ℝ)^j * marginal j := by
  cases j with
  | zero => norm_num [lifted, marginal, Mixed44.weights, Mixed44.profile, Mixed44.allowedA,
      Mixed44.allowedB]
  | succ j => simp only [lifted, marginal, Mixed44.weights, Int.cast_mul, Int.cast_add,
                Int.cast_pow, pow_succ]; push_cast; ring

