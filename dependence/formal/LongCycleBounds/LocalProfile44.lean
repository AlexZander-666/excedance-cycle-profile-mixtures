/-- Negative roots are all simple, and the original weighted row also has its simple zero. -/
theorem independent_simple : SimpleEndpointRow 44 (row 44 marginal) := by
  apply simple_unscale (c := (2:ℝ)^44) (by norm_num)
  rw [←row_rescale]
  have e := coefficients_correct lifted 44
  rw [table] at e
  have identify : row 44 (fun j => (2:ℝ)^j * marginal j) = X * ofCoeffs quotientCoeffs := by
    simpa only [ofCoeffs,Int.cast_zero,C_0,zero_add,lift_eq] using e.symm
  obtain ⟨cert⟩ := negativeMeshOK_sound signs
  have cnt : nodes.size - 1 = 42 := by decide
  simpa only [SimpleEndpointRow,identify,cnt] using cert.full_root_count
